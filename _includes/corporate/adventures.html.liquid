<section class="container-fluid page-content adventures-summary desktop">
  {% for adventure in site.data.adventures.adventures %}
    {% if adventure.corporate %}
      {% capture loop %}{% cycle 'odd', 'even' %}{% endcapture %}
      {% include adventures/desktop.html.liquid %}
    {% endif %}
  {% endfor %}
</section>
<section class="container-fluid adventures-summary mobile">
  {% for adventure in site.data.adventures.adventures %}
    {% if adventure.corporate %}
      {% include adventures/mobile.html.liquid %}
    {% endif %}
  {% endfor %}
</section>
