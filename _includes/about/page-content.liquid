<section class="container-fluid page-content">
    <div class="row justify-content-center">
        {% assign visible_members = site.data.team.team_members | where: "visible", true %}
        {% for member in visible_members %}
            <div class="card col">
                <h2>{{ member.name }}</h2>
                <img src="/assets/images/{{ member.image }}" alt="guide {{ member.name }}" loading="lazy">
                <h3>{{ member.job }}</h3>
                <p>{{ member.bio }}</p>
            </div>
        {% endfor %}
    </div>
</section>
