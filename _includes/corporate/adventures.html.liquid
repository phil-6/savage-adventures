<section class="container-fluid adventures-summary">
  {% for adventure in site.data.adventures.adventures %}
    {% if adventure.corporate %}
      {% capture loop %}{% cycle 'corp-odd', 'corp-even' %}{% endcapture %}
      <div class="row">
        {% if loop == 'corp-even' %}<div class="col-md-5 d-none d-md-block"></div>{% endif %}
        <div class="{% if loop == 'corp-even' %}col-md-7{% endif %}">
          {% include adventures/title-row.html.liquid %}
        </div>
      </div>
      <div class="row">
        <div class="col-md-5 {% if loop == 'corp-odd' %}order-md-2{% endif %}">
          <img src="/assets/images/{{ adventure.image }}" alt="{{ adventure.name }}" loading="lazy">
        </div>
        {% include adventures/summary-description.html.liquid %}
      </div>
    {% endif %}
  {% endfor %}
</section>
