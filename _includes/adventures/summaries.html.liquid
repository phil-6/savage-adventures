<section class="container-fluid adventures-summary desktop">
  {% for adventure in site.data.adventures.adventures %}
    {% if adventure.visible %}
      {% include adventures/desktop.html.liquid %}
    {% endif %}
  {% endfor %}
</section>
<section class="container-fluid adventures-summary mobile">
  {% for adventure in site.data.adventures.adventures %}
